{
  "name": "fussballmanager",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "worker"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev -w @fussballmanager/server",
    "dev:worker": "npm run dev -w @fussballmanager/worker",
    "build": "vite build",
    "check:worker-assets": "node scripts/check-worker-asset-sizes.mjs",
    "deploy:cloudflare": "npm run build && npm run deploy -w @fussballmanager/worker",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @fussballmanager/shared && npm run typecheck -w @fussballmanager/server && npm run typecheck -w @fussballmanager/worker",
    "test": "npm test -w @fussballmanager/shared && npm test -w @fussballmanager/server",
    "play-match": "npm run play-match -w @fussballmanager/server",
    "play-matchday": "npm run play-matchday -w @fussballmanager/server",
    "play-probe": "npm run play-probe -w @fussballmanager/server",
    "persist-match": "npm run persist-match -w @fussballmanager/server",
    "bake:portraits": "node scripts/bake-open-peeps-bust-charge2.mjs && node scripts/generate-portrait-catalog.mjs",
    "bake:portraits:full": "node scripts/bake-open-peeps-busts.mjs && node scripts/generate-portrait-catalog.mjs",
    "bake:hub-photos": "node scripts/bake-hub-photos.mjs",
    "bake:camp-photos": "node scripts/bake-camp-photos.mjs",
    "bake:club-logos": "node scripts/bake-club-logos.mjs",
    "study:opponent-scout": "npx vite-node scripts/run-opponent-scout-nordstern-study.ts",
    "study:opponent-scout:quick": "STUDY_QUICK=1 npx vite-node scripts/run-opponent-scout-nordstern-study.ts",
    "study:opponent-scout:quick-10": "STUDY_QUICK=1 STUDY_QUICK_TEAMS=10 npx vite-node scripts/run-opponent-scout-nordstern-study.ts"
  },
  "dependencies": {
    "@fussballmanager/shared": "*",
    "lucide-react": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}

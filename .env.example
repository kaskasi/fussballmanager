DATABASE_URL=postgres://fussballmanager:fussballmanager@localhost:5432/fussballmanager
PORT=3001

# Cloud Save M1 (PRD 18) — optional; without these, only local M0 export/import works.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Product analytics (optional — no-op when unset)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Optional release label for Sentry (CI build id)
VITE_APP_BUILD=

# Set in Supabase Dashboard → Edge Functions → Secrets (not in Vite):
# SYNC_CODE_PEPPER=long-random-string
